<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ControllerMagic</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>controller.ico</ApplicationIcon>
    <StartupObject>ControllerMagic.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Analyzer level and rule-suppression rationale live in the repo-root Directory.Build.props
         and .editorconfig, so every project here inherits the same settings. -->

    <Product>Controller Magic</Product>
    <AssemblyTitle>Turn a controller into a mouse, keyboard, and media remote</AssemblyTitle>
    <Description>Turn a controller into a mouse, keyboard, and media remote.</Description>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <Copyright>Copyright © $([System.DateTime]::Now.Year)</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="controller.ico" />
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ControllerMagic.Tests exercise internal-only surface (pure logic like
         ControllerPoller.ComputeHoldRamp, AppSettings' load/migrate path) without widening those
         members to public just for testability. -->
    <InternalsVisibleTo Include="ControllerMagic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
    <PackageReference Include="sdl2.nuget" Version="2.32.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>