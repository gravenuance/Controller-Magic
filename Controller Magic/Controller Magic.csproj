<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ControllerMagic</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>controller.ico</ApplicationIcon>
    <StartupObject>ControllerMagic.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The publish profile's RID, declared here so the lock file covers the published build too. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Analyzer level and rule-suppression rationale live in the repo-root Directory.Build.props
         and .editorconfig, so every project here inherits the same settings. -->

    <Product>Controller Magic</Product>
    <AssemblyTitle>Turn a controller into a mouse, keyboard, and media remote</AssemblyTitle>
    <Description>Turn a controller into a mouse, keyboard, and media remote.</Description>
    <Version>1.8.0</Version>
    <FileVersion>1.8.0.0</FileVersion>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <!-- A fixed year, not the build clock, so a build from a tag reproduces byte for byte. -->
    <Copyright>Copyright © 2025-2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="controller.ico" />
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ControllerMagic.Tests exercise internal-only surface (pure logic like
         ControllerPoller.ComputeHoldRamp, AppSettings' load/migrate path) without widening those
         members to public just for testability. -->
    <InternalsVisibleTo Include="ControllerMagic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
    <!-- ExcludeAssets=contentFiles: this package's only content file is a Mono-style dllmap
         app.config for resolving "SDL2" to libSDL2.so/.dylib on non-Windows - dead weight for a
         Windows-only (net10.0-windows) app, where the OS's own native-library loader already
         resolves a bare "SDL2" DllImport name to SDL2.dll without it. Doesn't affect the actual
         managed/native assets this package provides (compile/runtime/native), only this one
         copied-to-output config file. -->
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" ExcludeAssets="contentFiles" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="Nefarius.Drivers.HidHide" Version="3.4.0" />
    <PackageReference Include="Nefarius.Utilities.DeviceManagement" Version="5.2.0" />
    <!-- Nefarius.Vicius.Abstractions (a transitive dependency via Nefarius.Drivers.HidHide's
         HidHideSetupProvider) references NJsonSchema.Annotations attributes on its DTOs but
         doesn't declare it as a runtime dependency - System.Text.Json's reflection-based type-info
         building still has to resolve every custom attribute on a type's members regardless of
         whether it's looking for that one, so without this present, deserializing HidHide's
         update-check response throws a FileNotFoundException for this assembly. Version pinned to
         exactly what that compiled reference expects (11.3.2.0). -->
    <PackageReference Include="NJsonSchema.Annotations" Version="11.3.2" />
    <!-- Same reason as NJsonSchema.Annotations above: another attribute type
         Nefarius.Vicius.Abstractions references without declaring as a dependency. Confirmed via
         Nefarius.Vicius.Abstractions.dll's own GetReferencedAssemblies() that these two are the
         only non-framework assemblies it needs at all, so this closes out the whole gap in one
         pass rather than one exception-and-fix cycle at a time. Newtonsoft.Json keeps assembly
         version 13.0.0.0 across all 13.0.x NuGet releases, so the exact patch doesn't matter here. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>