<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The custom controls (ToggleSwitch, ChipList) are tested without ever creating a window handle. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- CA1707 (no underscores in identifiers): MethodName_Scenario_ExpectedBehavior is the
         standard xUnit test-naming convention - deliberately different from production naming,
         so this is suppressed here only, not repo-wide via the root .editorconfig. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 4.0.0 installs xunit.v3.mtp-v2, which needs Microsoft.Testing.Platform >= 2.4.0.
         Microsoft.Testing.Extensions.CodeCoverage 18.11.2 now requires that same 2.4.0 floor, so
         both packages resolve onto the same Microsoft.Testing.Platform major version again. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Controller Magic\Controller Magic.csproj" />
  </ItemGroup>

</Project>
