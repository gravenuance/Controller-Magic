<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- CA1707 (no underscores in identifiers): MethodName_Scenario_ExpectedBehavior is the
         standard xUnit test-naming convention - deliberately different from production naming,
         so this is suppressed here only, not repo-wide via the root .editorconfig. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 3.2.2 installs xunit.v3.mtp-v1 - a build compiled against the Microsoft.Testing
         Platform *1.x* API surface specifically (not just "1.9.1 or higher" in the loose NuGet
         sense - 2.x made breaking API changes, e.g. to IOutputDevice.DisplayAsync). xunit.v3 4.0.0
         needs mtp-v2, which needs a Microsoft.Testing.Platform >= 2.4.0 that isn't published yet.
         Microsoft.Testing.Extensions.CodeCoverage 18.0.4 is the newest version whose own
         Microsoft.Testing.Platform requirement still resolves within that same 1.x line. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Controller Magic\Controller Magic.csproj" />
  </ItemGroup>

</Project>
