root = true

[*.{cs,vb}]

# WFO1000 (WinForms designer serialization): all UI here is built at runtime in code (see
# SettingsForm.Designer.cs) and none of the custom controls are ever bound in the WinForms
# Designer, so this requirement doesn't apply.
dotnet_diagnostic.WFO1000.severity = none

# CA2213 (disposable field never disposed): every flagged field is a child Control already living
# in a parent's Controls collection, or a Form closed via Close() (which disposes by default) -
# WinForms' own disposal cascade already handles these; this general-purpose rule can't see it.
dotnet_diagnostic.CA2213.severity = none

# CA1303/CA1305/CA1308 (globalization: localize strings, specify IFormatProvider, normalize
# casing): single-culture English-only desktop utility with no current or planned localization.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1308.severity = none

# CA1031 (catch specific exception types): every site is a deliberate error boundary around
# something that must not crash the app or a background thread - settings I/O, registry/schtasks
# calls, the top-level fatal-exception handler itself. Reviewed individually; all intentional.
dotnet_diagnostic.CA1031.severity = none

# CA1814 (multidimensional array): Daisywheel/KeyboardLayout is a fixed 3x8x4 lookup table - a
# jagged array would trade a compact literal for ~24 nested array allocations for no gain.
dotnet_diagnostic.CA1814.severity = none
